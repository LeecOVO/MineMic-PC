#include <windows.h>
1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@MINEMIC_BUILD_NUMBER@
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@MINEMIC_BUILD_NUMBER@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "MineMic - Phone microphone receiver\0"
            VALUE "FileVersion", "@MINEMIC_VERSION@\0"
            VALUE "InternalName", "MineMic\0"
            VALUE "OriginalFilename", "MineMic.exe\0"
            VALUE "ProductName", "MineMic\0"
            VALUE "ProductVersion", "@MINEMIC_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
